# ==== StayLiquid Engine · variables de entorno ====
# Copia este archivo a ".env" y rellena los valores. NUNCA subas el .env a git.

# --- Vault ---
# Master Key para cifrar las claves de los clientes (Fase 1 = local; en produccion usa un KMS).
# Genera una con:  npm run keygen
MASTER_KEY_B64=

# --- Modo de ejecucion ---
# paper = simula las ordenes y las registra, NO toca dinero real (empieza SIEMPRE aqui).
# live  = envia ordenes reales al exchange (solo tras validar todo en paper).
EXEC_MODE=paper

# --- Fuente de senales ---
# URL de donde el motor lee las senales de la estrategia (tu backend / worker).
# En Fase 1 puedes usar el archivo local de ejemplo: file://./signals.sample.json
SIGNALS_URL=file://./signals.sample.json
SIGNALS_POLL_MS=5000

# --- Exchange por defecto para pruebas (el cliente trae las suyas) ---
# Para pruebas en paper no hace falta clave real.
DEFAULT_EXCHANGE=binance

# --- API de conexion (el panel del frontend habla con esto) ---
API_PORT=8787
# Token compartido con el frontend para autorizar las llamadas (Fase 1).
# En produccion se cambia por verificacion del ID token de Firebase del usuario.
ENGINE_API_TOKEN=
# Origen permitido para CORS (tu web). Ej: https://stayliquid.tech
CORS_ORIGIN=*

# --- Almacenamiento ---
# Si pones SUPABASE_URL + SUPABASE_SERVICE_KEY, TODO se guarda en Supabase.
# Si no, cae a archivos JSON locales en ./data.
SUPABASE_URL=
# IMPORTANTE: usa la clave "service_role" (secreta, Settings -> API), NO la "anon".
SUPABASE_SERVICE_KEY=
DATA_DIR=./data

# --- Copy Bot de Solana con dinero REAL (apagado por defecto) ---
# on = el motor opera de verdad con las wallets de bot de los usuarios. Hazlo solo tras la primera prueba con tu propia wallet y ~0,05 SOL.
SOLBOT_LIVE=off
# RPC de Solana de pago (Helius/QuickNode...). El público de mainnet se limita y falla en 24/7. NO subas esta URL a git: lleva la clave dentro.
SOLANA_RPC_URL=
JUPITER_API_KEY=
# Cuenta de referido de Jupiter (la misma que usa la web) y comisión en puntos básicos
JUP_REFERRAL_ACCOUNT=
SOLBOT_FEE_BPS=110
